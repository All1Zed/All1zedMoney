# Database Configuration
DATABASE_URL=sqlite:///./payment_gateway.db
# For PostgreSQL: postgresql://user:password@localhost/payment_gateway

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Konik SOAP Configuration
WSDL_URL=https://konik.cgrate.com/wsdl
SERVICE_URL=https://konik.cgrate.com/service
KONIK_USERNAME=your_konik_username
KONIK_PASSWORD=your_konik_password

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PAYMENTS=50/minute
RATE_LIMIT_ANALYTICS=30/minute
RATE_LIMIT_WEBHOOKS=1000/minute

# Webhook Configuration
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAYS=[60,300,900]

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s 